VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_ALLOWED_EMAILS=email1@example.com,email2@example.com

# EmailJS – for email reminders (get keys at https://www.emailjs.com)
VITE_EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY

# Twilio – for SMS reminders (get keys at https://www.twilio.com/console)
# WARNING: these keys will be bundled in the client JS (fine for private admin apps only)
VITE_TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
VITE_TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
VITE_TWILIO_FROM_NUMBER=+1XXXXXXXXXX
